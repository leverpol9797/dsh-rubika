# Get a bot token from @BotFather on Rubika (https://rubika.ir — search BotFather@).
# Required. The gateway stays disabled until this is set.
RUBIKA_BOT_TOKEN=

# Optional. Comma-separated Rubika user IDs allowed to use the bot.
# User IDs start with "u". Empty / unset = allow everyone (same as ALLOW_ALL=true).
# Example: RUBIKA_ALLOWED_USERS=uAAAA1111BBBB2222CCCC3333DDDD4444,uEEEE5555FFFF6666GGGG7777HHHH8888
RUBIKA_ALLOWED_USERS=

# Optional. Set to "true" to explicitly allow everyone.
RUBIKA_ALLOW_ALL_USERS=

# Optional. Comma-separated group/channel chat IDs the bot may answer in.
# Group chat IDs start with "g". The bot must be a member of the group.
# Messages from other groups are silently ignored.
# Example: RUBIKA_GROUP_ALLOWED_CHATS=g0CCAn90d1e645fab25586b610e21cbc
RUBIKA_GROUP_ALLOWED_CHATS=
